# Google Gemini API key for generating embeddings
GEMINI_API_KEY=your_google_gemini_api_key_here

# The Gemini model to use for embeddings (default: gemini-embedding-2-preview)
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview

# Storage backend: "json" (default, local file) or "chroma" (ChromaDB server)
STORE_BACKEND=chroma

# ChromaDB server URL (used when STORE_BACKEND=chroma)
CHROMA_URL=http://localhost:8000

# ChromaDB collection name
CHROMA_COLLECTION=searchmagnet